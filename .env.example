# Copy to .env and supply only the connector variables you want enabled.
# Missing connector variables disable that store; no placeholder is used as a host.

MCP_EXTERNAL_URL=https://your-mcp-server.example
GITHUB_PERSONAL_ACCESS_TOKEN=
TRILIUM_API_URL=https://your-trilium-server.example/etapi
TRILIUM_API_TOKEN=
TAVILY_API_KEY=

# Connector values are server-local. Comma-separate multiple allowed directories.
# Example: FS_DGX_ALLOWED_DIRS=/home/user/,/home/user/.specstory/history
FS_DGX_HOST=
FS_DGX_USER=
FS_DGX_ALLOWED_DIRS=
FS_DGX_PROFILE_STORAGE_PATH=
FS_DGX_WORKSPACE_STORAGE_ROOT=
