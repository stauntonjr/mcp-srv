        "CHAT_PROXMOX_WORKSPACE_STORAGE_ROOT": "/root/.vscode-server/data/User/workspaceStorage",
        "CHAT_PROXMOX_ALLOWED_DIRS": "/root/.vscode-server/data/User/globalStorage,/root/.vscode-server/data/User/workspaceStorage"
      }
    },
