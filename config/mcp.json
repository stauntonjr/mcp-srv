{
  "mcpServers": {
    "microsoft-learn": {
      "type": "http",
      "disabled": false,
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "github": {      
      "env": {
        "PYTHONUNBUFFERED": "1",
        "FS_DNS_HOST": "10.0.0.152",
        "FS_DNS_USER": "root",
        "FS_DNS_KEY_PATH": "/root/dotfiles/ssh/id_ed25519",
        "FS_DNS_ALLOWED_DIRS": "/root/"
      },
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "context7": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "sequential": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "fetch": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@kazuph/mcp-fetch"
      ]
    },
    "memory": {
      "type": "stdio",
      "disabled": false,
      "command": "bash",
      "args": [
        "-lc",
        "MEMORY_HOME=/stores/default npx -y @modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_HOME": "/stores/default",
        "MEMORY_FILE_PATH": "/stores/default/memory.jsonl"
      }
    },
    "chart": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@antv/mcp-server-chart"
      ]
    },
    "pandoc": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "mcp-pandoc"
      ]
    },
    "puppeteer": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ]
    },
    "playwright": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--no-sandbox",
        "--isolated",
        "--executable-path",
        "/root/.cache/ms-playwright/chromium-1187/chrome-linux/chrome"
      ]
    },
    "tavily": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp@0.1.3"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "tavily-remote": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp@0.1.3"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    }
    ,
    "filesystem-sshfs-proxmox": {
      "type": "stdio",
      "disabled": false,
      "command": "python",
      "args": [
        "-m",
        "mcp_filesystem_sshfs",
        "--host",
        "${FS_PROXMOX_HOST}",
        "--username",
        "${FS_PROXMOX_USER}",
        "--key-path",
        "${FS_PROXMOX_KEY_PATH}",
        "--allowed-dirs",
        "${FS_PROXMOX_ALLOWED_DIRS}"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "FS_PROXMOX_HOST": "10.0.0.250",
        "FS_PROXMOX_USER": "root",
        "FS_PROXMOX_KEY_PATH": "/root/dotfiles/ssh/id_ed25519",
        "FS_PROXMOX_ALLOWED_DIRS": "/root/"
      }
    },
    "chat-history-sshfs-proxmox": {
      "type": "stdio",
      "disabled": false,
      "command": "python",
      "args": [
        "-m",
        "mcp_filesystem_sshfs.chat_history",
        "--host",
        "${FS_PROXMOX_HOST}",
        "--username",
        "${FS_PROXMOX_USER}",
        "--key-path",
        "${FS_PROXMOX_KEY_PATH}",
        "--profile-storage-path",
        "${CHAT_PROXMOX_PROFILE_STORAGE_PATH}",
        "--workspace-storage-root",
        "${CHAT_PROXMOX_WORKSPACE_STORAGE_ROOT}",
        "--allowed-dirs",
        "${CHAT_PROXMOX_ALLOWED_DIRS}"
