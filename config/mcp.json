{
  "mcpServers": {
    "microsoft-learn": {
      "type": "http",
      "disabled": false,
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "github": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "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",
        "GH_TOKEN": "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"
      }
    },
    "context7": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "sequential": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "fetch": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@kazuph/mcp-fetch"
      ]
    },
    "memory": {
      "type": "stdio",
      "disabled": false,
      "command": "bash",
      "args": [
        "-lc",
        "MEMORY_HOME=/stores/default npx -y @modelcontextprotocol/server-memory"
      ]
    },
    "chart": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@antv/mcp-server-chart"
      ]
    },
    "pandoc": {
      "type": "stdio",
      "disabled": false,
      "command": "uvx",
      "args": [
        "mcp-pandoc"
      ]
    },
    "puppeteer": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ]
    },
    "playwright": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--no-sandbox",
        "--isolated",
        "--executable-path",
        "/root/.cache/ms-playwright/chromium-1187/chrome-linux/chrome"
      ]
    },
    "tavily-remote": {
      "type": "stdio",
      "disabled": false,
      "command": "bash",
      "args": [
        "-lc",
        "npx -y mcp-remote https://mcp.tavily.com/mcp/?tavilyApiKey="
      ]
    }
  }
}