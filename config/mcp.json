{
  "mcpServers": {
    "microsoft-learn": {
      "type": "http",
      "disabled": false,
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "github": {      
      "type": "http",
      "disabled": false,
      "url": "https://api.githubcopilot.com/mcp/",
      "requestInit": {
        "headers": {
          "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      }
    },
    "context7": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "sequential": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "fetch": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@kazuph/mcp-fetch"
      ]
    },
    "memory": {
      "type": "stdio",
      "disabled": false,
      "command": "bash",
      "args": [
        "-lc",
        "MEMORY_HOME=/stores/default npx -y @modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_HOME": "/stores/default",
        "MEMORY_FILE_PATH": "/stores/default/memory.jsonl"
      }
    },
    "chart": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "@antv/mcp-server-chart"
      ]
    },
    "pandoc": {
      "type": "stdio",
      "disabled": true,
      "command": "npx",
      "args": [
        "-y",
        "mcp-pandoc"
      ]
    },
    "puppeteer": {
      "type": "stdio",
      "disabled": true,
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ]
    },
    "playwright": {
      "type": "stdio",
      "disabled": false,
      "command": "python3",
      "args": [
        "/config/scripts/playwright-schema-compat.py"
      ]
    },
    "tavily": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp@0.1.3"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "tavily-remote": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp@0.1.3"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    }
    ,
    "triliumnext-md-srv": {
      "type": "stdio",
      "disabled": false,
      "command": "npx",
      "args": [
        "-y",
        "triliumnext-mcp"
      ],
      "env": {
        "TRILIUM_API_URL": "https://md.ediacarian.home/etapi",
        "TRILIUM_API_TOKEN": "***REMOVED***",
        "PERMISSIONS": "READ;WRITE",
        "NODE_EXTRA_CA_CERTS": "/certs/ca.crt"
      }
    }
    ,
    "filesystem-sshfs-multi": {
      "type": "stdio",
      "disabled": false,
      "command": "python3",
      "args": [
  "-c",
  "import sys, runpy; sys.argv=['mcp_filesystem_sshfs.multi_backend','--connectors','/config/filesystem-connectors.json']; runpy.run_module('mcp_filesystem_sshfs.multi_backend', run_name='__main__')"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
    ,
    "filesystem-sshfs-proxmox": {
      "type": "stdio",
      "disabled": true,
      "command": "python3",
      "args": [
        "-m",
        "mcp_filesystem_sshfs",
        "--host",
        "${FS_PROXMOX_HOST}",
        "--username",
        "${FS_PROXMOX_USER}",
        "--key-path",
        "${FS_PROXMOX_KEY_PATH}",
        "--allowed-dirs",
        "${FS_PROXMOX_ALLOWED_DIRS}"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "FS_PROXMOX_HOST": "10.0.0.250",
        "FS_PROXMOX_USER": "root",
      "FS_PROXMOX_KEY_PATH": "/ssh/id_ed25519",
        "FS_PROXMOX_ALLOWED_DIRS": "/root/"
      }
    },
    "chat-history-sshfs-proxmox": {
      "type": "stdio",
      "disabled": true,
      "command": "python3",
      "args": [
        "-m",
        "mcp_filesystem_sshfs.chat_history",
        "--host",
        "${FS_PROXMOX_HOST}",
        "--username",
        "${FS_PROXMOX_USER}",
        "--key-path",
        "${FS_PROXMOX_KEY_PATH}",
        "--profile-storage-path",
        "${CHAT_PROXMOX_PROFILE_STORAGE_PATH}",
        "--workspace-storage-root",
        "${CHAT_PROXMOX_WORKSPACE_STORAGE_ROOT}",
        "--allowed-dirs",
        "${CHAT_PROXMOX_ALLOWED_DIRS}"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "FS_PROXMOX_HOST": "10.0.0.250",
        "FS_PROXMOX_USER": "root",
        "FS_PROXMOX_KEY_PATH": "/ssh/id_ed25519",
        "CHAT_PROXMOX_PROFILE_STORAGE_PATH": "/root/.vscode-server/data/User/globalStorage",
        "CHAT_PROXMOX_WORKSPACE_STORAGE_ROOT": "/root/.vscode-server/data/User/workspaceStorage",
        "CHAT_PROXMOX_ALLOWED_DIRS": "/root/.vscode-server/data/User/globalStorage,/root/.vscode-server/data/User/workspaceStorage"
      }
    },
